{
  "info": {
    "_postman_id": "2ab41824-9876-4f50-a1b2-1f2c3440b220",
    "name": "Employee Management API",
    "description": "CRUD, pagination, search, and status-filter requests for the Employee Management API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "employeeId", "value": "1" }
  ],
  "item": [
    {
      "name": "Create employee",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "if (pm.response.code === 201) {",
          "  const employee = pm.response.json();",
          "  pm.collectionVariables.set('employeeId', employee.id);",
          "}"
        ] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Rao\",\n  \"email\": \"asha.rao@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Backend Developer\",\n  \"salary\": 75000.00,\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/employees"
      }
    },
    {
      "name": "List employees",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/employees?page=0&size=20&sort=lastName,asc" }
    },
    {
      "name": "Search active employees",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/employees?search=engineering&status=ACTIVE&page=0&size=10" }
    },
    {
      "name": "Get employee by ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/employees/{{employeeId}}" }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Rao\",\n  \"email\": \"asha.rao@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Senior Backend Developer\",\n  \"salary\": 82000.00,\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/employees/{{employeeId}}"
      }
    },
    {
      "name": "Delete employee",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/employees/{{employeeId}}" }
    },
    {
      "name": "Validation error example",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Rao\",\n  \"email\": \"not-an-email\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Developer\",\n  \"salary\": 0,\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/v1/employees"
      }
    }
  ]
}
